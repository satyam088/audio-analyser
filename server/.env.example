# Node.js Server Configuration
PORT=5001
SERVER_URL=http://localhost:5001
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Database & Authentication
JWT_SECRET=your_jwt_secret_key_here
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# Email Service Provider Options
# Option A: Resend API (https://resend.com)
# Note: With onboarding@resend.dev, Resend only sends testing emails to the account owner.
# To send to ANY recipient, verify your domain at https://resend.com/domains and set EMAIL_USER=noreply@yourdomain.com
RESEND_API_KEY=re_your_api_key_here
EMAIL_USER=onboarding@resend.dev

# Option B: SMTP / Gmail (Nodemailer - Send to ANY email without a custom domain!)
# For Gmail: enable 2FA and generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="AudioLens" <your_email@gmail.com>

# AWS S3 Storage Configuration (Leave blank for local filesystem fallback in /uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
