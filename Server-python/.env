# Gemini API Configuration
# Leave blank or paste your Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# AWS S3 Configuration (Leave blank for user keys)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# Python Server Port
PORT=8000
